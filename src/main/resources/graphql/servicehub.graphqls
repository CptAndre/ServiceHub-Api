type Query {
  provider(id: ID!): Provider
  providers(specialty: String, page: Int = 0, size: Int = 20): [Provider!]!
  servicesByProvider(providerId: ID!, page: Int = 0, size: Int = 20): [Service!]!
}

type Mutation {
  createService(input: CreateServiceInput!): Service!
  bookService(input: BookServiceInput!): Booking!
}

input CreateServiceInput {
  providerId: ID!
  title: String!
  description: String
  price: Float!
  category: ServiceCategory!
}

input BookServiceInput {
  clientId: ID!
  serviceId: ID!
}

type Provider {
  id: ID!
  name: String!
  specialty: String
  phone: String
  services(page: Int = 0, size: Int = 20): [Service!]!
}

type Service {
  id: ID!
  title: String!
  description: String
  price: Float!
  providerId: ID!
  category: ServiceCategory!
}

"""A booking corresponds to a ServiceHub contract."""
type Booking {
  id: ID!
  description: String!
  totalValue: Float!
  status: String!
  clientId: ID!
  providerId: ID!
  serviceId: ID
}

enum ServiceCategory {
  LIMPEZA
  DIARISTA
  ENCANAMENTO
  ELETRICA
  JARDINAGEM
  PINTURA
  MARCENARIA
  PEDREIRO
  DEDETIZACAO
  AR_CONDICIONADO
  CHAVEIRO
  MONTAGEM_MOVEIS
  MUDANCA
  SUPORTE_TECNICO
  MANUTENCAO_COMPUTADORES
  DESENVOLVIMENTO_SOFTWARE
  REDES_E_INFRAESTRUTURA
  SEGURANCA_DIGITAL
  RECUPERACAO_DE_DADOS
  CONSULTORIA_TI
  OUTROS
}
